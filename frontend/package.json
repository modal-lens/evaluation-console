{
  "name": "nanjing-evaluation-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.mjs --dev",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "contract": "python scripts/export_contract.py",
    "contract:check": "python scripts/export_contract.py --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
