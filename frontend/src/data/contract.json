{
  "operations": {
    "entity-extraction": {
      "path": "/api/v1/evaluation/entity-extraction",
      "title": "实体抽取 F1",
      "schema": {
        "$ref": "#/components/schemas/EntityEvaluationRequest"
      },
      "example": {
        "samples": [
          {
            "sample_id": "doc-1",
            "predicted": [
              {
                "name": "南京大学",
                "type": "组织"
              }
            ],
            "gold": [
              {
                "name": "南京大学",
                "type": "组织"
              },
              {
                "name": "张三",
                "type": "人物"
              }
            ]
          }
        ]
      },
      "exampleDescription": "predicted 为算法预测，gold 为人工标注；本例漏抽一个实体，F1 为 2/3。"
    },
    "relation-extraction": {
      "path": "/api/v1/evaluation/relation-extraction",
      "title": "关系抽取 F1",
      "schema": {
        "$ref": "#/components/schemas/RelationEvaluationRequest"
      },
      "example": {
        "samples": [
          {
            "sample_id": "doc-1",
            "predicted": [
              {
                "head_entity_id": "person-1",
                "relationCode": "任职",
                "tail_entity_id": "org-1"
              }
            ],
            "gold": [
              {
                "head_entity_id": "person-1",
                "relationCode": "任职",
                "tail_entity_id": "org-1"
              }
            ]
          }
        ]
      },
      "exampleDescription": "预测与标注须使用同一实体 ID；本例三元组完全一致，F1 为 1。"
    },
    "cross-document/entity-fusion": {
      "path": "/api/v1/evaluation/cross-document/entity-fusion",
      "title": "跨文档实体消融 F1",
      "schema": {
        "$ref": "#/components/schemas/FusionEvaluationRequest"
      },
      "example": {
        "items": [
          {
            "item_id": "doc-1-entity-1",
            "document_id": "doc-1",
            "language": "zh",
            "gold_cluster": "gold-1",
            "predicted_cluster": "prediction-A"
          },
          {
            "item_id": "doc-2-entity-1",
            "document_id": "doc-2",
            "language": "zh",
            "gold_cluster": "gold-1",
            "predicted_cluster": "prediction-A"
          },
          {
            "item_id": "doc-3-entity-1",
            "document_id": "doc-3",
            "language": "zh",
            "gold_cluster": "gold-2",
            "predicted_cluster": "prediction-B"
          }
        ]
      },
      "exampleDescription": "item_id 是对象的一次出现 ID；gold_cluster 表示人工合并分组，predicted_cluster 表示算法分组。本例正确合并前两个对象，第三个不合并，F1 为 1。"
    },
    "cross-document/relation-fusion": {
      "path": "/api/v1/evaluation/cross-document/relation-fusion",
      "title": "跨文档关系消融 F1",
